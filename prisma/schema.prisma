generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tarefa {
  id Int @id @default(autoincrement())
  titulo String
  feito Boolean @default(false)
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int
}

model Usuario {
  id Int @id @default(autoincrement())
  email String @unique
  senha String
  tarefas Tarefa[]
}